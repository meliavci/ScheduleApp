    <bpmn:textAnnotation id="TextAnnotation_168jeds">
      <bpmn:text>There is a system trigger that retrieves course information, enrollments, student and professor data and professor availability one week before the start of a semester.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0o4h8pp">
      <bpmn:text>Retrieve user role, name, e-mail and courses</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1yr7o7r">
      <bpmn:text>Filtering out all the courses that belongs to the logged in user</bpmn:text>
    </bpmn:textAnnotation>
